{
  "manifest_version": 3,
  "name": "Online Voice Typing | NR Company",
  "version": "2.3.0",
  "description": "Online Voice Typing by NR Company — multilingual speech-to-text for Chrome.",
  "minimum_chrome_version": "114",
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab",
    "scripting",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://api.groq.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://openrouter.ai/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src https://api.groq.com https://generativelanguage.googleapis.com https://openrouter.ai; img-src 'self' data:"
  },
  "background": {
    "service_worker": "js/background.js"
  },
  "action": {
    "default_title": "Open Online Voice Typing",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
